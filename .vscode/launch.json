{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ProBank.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ProBank.Api/bin/Debug/net10.0/ProBank.Api.dll",
      "cwd": "${workspaceFolder}/src/ProBank.Api",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "https://localhost:7101" }
    },
    {
      "name": "ProBank.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ProBank.Web/bin/Debug/net10.0/ProBank.Web.dll",
      "cwd": "${workspaceFolder}/src/ProBank.Web",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development", "ASPNETCORE_URLS": "https://localhost:7001" },
      "serverReadyAction": { "action": "openExternally", "pattern": "Now listening on:\\s+(https?://\\S+)" }
    },
    {
      "name": "ProBank.Setup",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-setup",
      "program": "${workspaceFolder}/tools/ProBank.Setup/bin/Debug/net10.0/ProBank.Setup.dll",
      "args": ["admin", "--usuario", "admin.sistema"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    { "name": "Api + Web", "configurations": ["ProBank.Api", "ProBank.Web"], "stopAll": true }
  ]
}
