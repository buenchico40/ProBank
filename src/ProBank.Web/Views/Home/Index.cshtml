@{ ViewData["Title"] = "Panel"; }
@section Scripts {
<script src="~/js/marketing.js" asp-append-version="true"></script>
<script>
  // Inicio / Panel: carrusel de imágenes promocionales a todo el ancho con los indicadores montados sobre su borde,
  // comunicados vigentes del rol activo y, abajo, los gráficos en formato compacto.
  pb.listo.then(async () => {
    const $content = $("#content");
    $content.append('<nav class="crumbs" aria-label="Migas de pan"><b>Inicio / Panel</b></nav>');
    $content.append($("<h1>").text("Panel · " + pb.sesion.rolActivo));
    if (!pb.can("inicio", "ver")) { $('<div class="card pad">').appendTo($content).append('<p class="muted" style="margin:0">Su rol activo no tiene acceso al Panel. Cambie de rol desde su perfil o use el menú.</p>'); return; }
    const d = await pb.get("/Home/Panel");
    if (!d) return;
    const FONT = "Inter, Roboto, system-ui, sans-serif";
    const ac = getComputedStyle(document.documentElement).getPropertyValue("--ac").trim() || "#0B5CAD";
    const ir = k => { const it = pb.menu.flatMap(g => g.items).find(i => i[0] === k); window.location.href = it && it[2] ? it[2] : "/Home/Opcion?clave=" + k; };

    // MKT-01: carrusel a todo el ancho (440 px): la imagen completa arriba y el texto en su franja, sin taparla. Sin promociones no ocupa espacio.
    const promos = d.promociones;
    if (promos.length) {
      const $h = $('<section class="card panel-hero" aria-label="Novedades del banco">').appendTo($content);
      $("<div>").appendTo($h).dxGallery({ dataSource: promos, height: "100%", width: "100%", loop: promos.length > 1, slideshowDelay: promos.length > 1 ? 7000 : 0,
        showNavButtons: false, swipeEnabled: promos.length > 1, showIndicator: promos.length > 1, itemTemplate: p => mkt.hero(p) });
    }

    // Indicadores: montados sobre el borde inferior del carrusel; toda la tarjeta abre su detalle
    const kpis = [["Coactivas activas", d.coactivasActivas, "coactivas", "money"], ["Aprobaciones pendientes", d.aprobacionesPendientes, "aprobaciones", "check"],
                  ["Tareas asignadas", d.tareasAsignadas, "tareas", "event"], ["Renovaciones por vencer", d.renovacionesPorVencer, "renovaciones", "refresh"]];
    const $k = $('<div class="kpis">').toggleClass("kpis-flotantes", promos.length > 0).appendTo($content);
    kpis.forEach(k => {
      const $c = $('<div class="card kpi">').toggleClass("cero", !k[1]).appendTo($k);
      $c.append($('<span class="kpi-tit">').append($('<i class="dx-icon dx-icon-' + k[3] + '">')).append($("<span>").text(k[0]))).append($("<strong>").text(k[1]));
      if (pb.can(k[2], "ver")) {
        $c.addClass("kpi-link").attr({ role: "link", tabindex: 0, "aria-label": k[0] + ": " + k[1] + ". Ver detalle" }).append($("<small>").text("Ver detalle ›"))
          .on("click", () => ir(k[2])).on("keydown", e => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); ir(k[2]); } });
      }
    });

    // MKT-02: comunicados vigentes para el rol activo a todo el ancho; el destacado arriba, los demás como tarjetas
    const COMTYPE = mkt.COMTYPE;
    const vig = r => "Vigente " + mkt.vigencia(r).replace(/^Del/, "del");
    const coms = d.comunicados;
    const $cc = $('<div class="card mkt-coms">').appendTo($content);
    $('<div class="mkt-hd">').appendTo($cc).append($("<h2>").text("Comunicados")).append($('<span class="muted">').text(coms.length + " vigentes"));
    if (!coms.length) $cc.append('<p class="muted">No hay comunicados vigentes para su rol.</p>');
    const hero = coms.find(r => r.destacado), rest = coms.filter(r => r !== hero);
    if (hero) {
      const ty = COMTYPE[hero.tipo] || COMTYPE.Aviso;
      const $h = $('<button type="button" class="com-hero">').addClass("t-" + ty.k).on("click", () => mkt.leer(hero)).appendTo($cc);
      $h.append($('<div class="com-top">').append($('<span class="com-ico dx-icon dx-icon-' + ty.i + '">')).append($('<span class="com-type">').text(hero.tipo)).append($('<span class="com-flag">').text("Destacado")));
      $h.append($('<strong class="com-title">').text(hero.titulo)).append($('<span class="com-sum">').text(hero.resumen));
      $h.append($('<span class="com-meta">').text(vig(hero) + " · Leer comunicado"));
    }
    const $l = $('<div class="com-list">').appendTo($cc);
    rest.slice(0, 6).forEach(r => {
      const ty = COMTYPE[r.tipo] || COMTYPE.Aviso;
      const $it = $('<button type="button" class="com-card">').addClass("t-" + ty.k).on("click", () => mkt.leer(r)).appendTo($l);
      $it.append($('<span class="com-ico dx-icon dx-icon-' + ty.i + '">'));
      $('<span class="com-body">').appendTo($it).append($('<span class="com-type">').text(r.tipo)).append($('<strong class="com-title">').text(r.titulo))
        .append($('<span class="com-sum">').text(r.resumen)).append($('<span class="com-meta">').text(r.hasta ? "Hasta el " + pb.fecha(r.hasta) : vig(r)));
    });
    if (rest.length > 6) $cc.append($('<span class="muted">').text("y " + (rest.length - 6) + " más en Marketing › Comunicados"));

    // Gráficos compactos: barras horizontales finas (cobertura) y dona con leyenda (ítems de TI)
    const $ch = $('<div class="charts charts-compactas">').appendTo($content);
    const tarjeta = t => $('<div class="card">').append($("<h2>").text(t)).appendTo($ch);
    $("<div>").appendTo(tarjeta("Cobertura de coactivas")).dxChart({
      dataSource: d.cobertura.map(x => ({ label: x.etiqueta, value: x.valor })), rotated: true, size: { height: 140 }, legend: { visible: false },
      commonSeriesSettings: { argumentField: "label", valueField: "value", type: "bar", barPadding: 0.45, cornerRadius: 3,
        label: { visible: true, backgroundColor: "transparent", position: "outside", font: { family: FONT, color: "#1B2430", weight: 600 } } },
      series: [{ name: "Coactivas", color: ac }],
      valueAxis: { visible: false, grid: { visible: false }, tick: { visible: false }, minorTick: { visible: false }, label: { visible: false }, valueMarginsEnabled: true, maxValueMargin: 0.15, allowDecimals: false },
      argumentAxis: { inverted: true, label: { font: { family: FONT, color: "#46505E" } }, tick: { visible: false } },
      tooltip: { enabled: true, font: { family: FONT }, customizeTooltip: a => ({ text: a.argumentText + ": " + a.valueText }) }
    });
    $("<div>").appendTo(tarjeta("Ítems de TI por tipo")).dxPieChart({
      dataSource: d.items.map(x => ({ label: x.etiqueta, value: x.valor })), type: "doughnut", innerRadius: 0.62, size: { height: 140 },
      palette: [ac, "#1E7B3A", "#D40E14"], resolveLabelOverlapping: "shift",
      series: [{ argumentField: "label", valueField: "value", label: { visible: false } }],
      legend: { horizontalAlignment: "right", verticalAlignment: "center", itemTextPosition: "right", font: { family: FONT, color: "#1B2430" },
        customizeText: a => a.pointName + " · " + (d.items.find(x => x.etiqueta === a.pointName) || {}).valor },
      tooltip: { enabled: true, font: { family: FONT }, customizeTooltip: a => ({ text: a.argumentText + ": " + a.valueText }) }
    });
  });
</script>
}
