@{ ViewData["Title"] = "Registro de decisiones"; ViewData["Opcion"] = "decisiones"; }
@section Scripts {
<script src="~/js/decisiones.js" asp-append-version="true"></script>
<script>
  // DEC-01 a DEC-07: decisiones del banco. Se registra con sus notificados y los aprobadores que propone su tipo (se pueden
  // agregar más; quitar, solo mientras nadie haya firmado) → Enviar (se sella el contenido) → cada aprobador aprueba, rechaza o
  // modifica (versión nueva: todos vuelven a firmar) → Aprobada o Rechazada; se anula con motivo mientras no se cierre.
  pb.listo.then(() => {
    const $c = $("#content"), url = decisiones.url;
    let lista = null;
    const recargar = () => lista.recargar();

    function listado() {
      $c.empty();
      lista = pb.ui.grid({
        $c, modulo: "Decisiones", titulo: "Registro de decisiones", opcion: "decisiones", clave: "token",
        cargar: () => pb.get(url("Decisiones", "alcance=todas")),
        columnas: [
          { campo: "codigo", titulo: "Decisión" }, { campo: "titulo", titulo: "Título", ancho: 260 }, { campo: "tipo", titulo: "Tipo" }, { campo: "area", titulo: "Área" },
          { campo: "fecha", titulo: "Fecha", formato: "fecha" }, { campo: "creadoPor", titulo: "Registrada por" },
          { campo: "version", titulo: "Versión", valor: d => d.fechaEnvio ? "v" + d.version : "—" },
          { campo: "aprobadas", titulo: "Aprobaciones", valor: decisiones.avance }, { campo: "estado", titulo: "Estado", pill: true }
        ],
        anulada: d => d.estado === "Anulada",
        botones: [
          { text: "Nueva", icon: "add", type: "default", accion: "crear", onClick: () => ficha(null, "nuevo") },
          { text: "Editar", icon: "edit", accion: "editar", fila: true, onClick: d => d.estado !== "Borrador" ? pb.notify("Solo se edita en borrador: enviada, la corrige un aprobador con «Modificar»", "warning") : ficha(d.token, "edicion") },
          { text: "Enviar a aprobación", icon: "upload", accion: "editar", fila: true, onClick: enviar },
          { text: "Anular", icon: "clear", fila: true, onClick: anular }
        ],
        alAbrir: d => ficha(d.token, "consulta"),
        detalle: ($e, d) => decisiones.detalle($e, d, acciones(d, recargar), recargar)
      });
    }

    function acciones(d, listo) {
      const a = [];
      if (d.estado === "Borrador" && d.soyCreador && pb.can("decisiones", "editar")) a.push({ text: "Enviar a aprobación", icon: "upload", type: "default", onClick: () => enviar(d) });
      return a.concat(decisiones.accionesFirma(d, listo));
    }

    async function enviar(d) {
      if (d.estado !== "Borrador") return pb.notify(d.codigo + " ya fue enviada", "warning");
      if (!d.soyCreador) return pb.notify("Solo quien registró la decisión la envía a aprobación", "warning");
      if (!await pb.ui.confirmar("Enviar a aprobación", "¿Desea enviar <b>" + pb.esc(d.codigo) + "</b>? Su contenido queda sellado con su huella y pasa a sus aprobadores.", "Enviar", "default", "upload")) return;
      const r = await pb.post(url("Enviar", "token=" + d.token));
      if (r !== undefined) { pb.notify(d.codigo + " · " + r); lista.recargar(); }
    }

    function anular(d) {
      if (["Borrador", "En aprobación"].indexOf(d.estado) < 0) return pb.notify("Solo se anula una decisión en borrador o en aprobación", "warning");
      if (!(d.soyCreador && pb.can("decisiones", "editar")) && !pb.can("decisiones", "eliminar")) return pb.notify("Solo la anula quien la registró o quien tiene el permiso de anular", "warning");
      const data = { motivo: "" };
      pb.ui.openPopup("Anular " + d.codigo, $f => $("<div>").appendTo($f).dxForm({ formData: data, labelLocation: "top", showColonAfterLabel: false, items: [
        { template: () => $('<p class="muted" style="margin:0">').text("La decisión queda anulada; las firmas ya hechas y su trazabilidad se conservan.") },
        { dataField: "motivo", label: { text: "Motivo de la anulación" }, editorType: "dxTextArea", isRequired: true, editorOptions: { height: 80, maxLength: 500 } }] }).dxForm("instance"),
      async f => {
        if (!f.validate().isValid) return false;
        const r = await pb.post(url("Anular", "token=" + d.token), { motivo: data.motivo });
        if (r === undefined) return false;
        pb.notify(d.codigo + " · " + r); lista.recargar();
      }, "Anular", 480, { icono: "clear" });
    }

    async function ficha(token, modo) {
      const [lst, tipos, us] = await Promise.all([token ? pb.get(url("Decisiones", "alcance=todas")) : null, pb.get(url("Tipos", "soloActivos=true")), decisiones.cargarUsuarios()]);
      const d = token ? (lst || []).find(x => x.token === token) : null;
      if (token && !d) return pb.notify("No se encontró la decisión", "warning");
      const x = d ? await pb.get(url("Decision", "token=" + token)) : null;
      if (token && !x) return;
      const opciones = (tipos || []).map(t => ({ id: t.codigo, t: t.nombre + (t.secuencial ? " · en secuencia" : " · todos a la vez") }));
      if (d && !opciones.some(o => o.id === d.tipoCodigo)) opciones.push({ id: d.tipoCodigo, t: d.tipo + " (inactivo)" });
      const datos = d ? { codigo: d.codigo, tipo: d.tipoCodigo, titulo: d.titulo, area: d.area, fecha: pb.aFecha(d.fecha), descripcion: decisiones.aHtml(x.descripcion),
                          estado: d.estado + (d.fechaEnvio ? " · versión " + d.version : ""), registrada: d.creadoPor + " · " + pb.fechaHora(d.fechaRegistro),
                          notificados: x.notificados.map(n => n.usuarioId) }
                      : { codigo: "(se asigna al guardar)", tipo: opciones.length ? opciones[0].id : null, titulo: "", area: "", fecha: new Date(), descripcion: "",
                          estado: "Borrador", registrada: "—", notificados: [] };
      const borrador = !d || d.estado === "Borrador";
      const editable = !d || (borrador && d.soyCreador && pb.can("decisiones", "editar"));
      const refrescar = () => ficha(token, "consulta");
      pb.ui.detalle({
        $c, modulo: "Decisiones", titulo: "Registro de decisiones", modo, nombre: d && d.codigo + " · " + d.titulo, token: d && d.token, datos,
        soloLectura: modo === "consulta" && !editable,
        items: ro => [
          { dataField: "codigo", label: { text: "Decisión (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "tipo", label: { text: "Tipo de decisión (propone los aprobadores)" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: opciones, valueExpr: "id", displayExpr: "t" } },
          { dataField: "estado", label: { text: "Estado (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "titulo", label: { text: "Título" }, colSpan: 2, isRequired: !ro, editorOptions: { maxLength: 200 } },
          { dataField: "fecha", label: { text: "Fecha de la decisión" }, editorType: "dxDateBox", isRequired: !ro, editorOptions: { displayFormat: "dd/MM/yyyy" } },
          { dataField: "area", label: { text: "Área" }, isRequired: !ro, editorOptions: { maxLength: 100, placeholder: "Por ejemplo: Gerencia de TI" } },
          { dataField: "registrada", label: { text: "Registrada por (calculado)" }, colSpan: 2, editorOptions: { readOnly: true } },
          { dataField: "descripcion", label: { text: "Descripción: qué se decide, por qué, con qué alcance y montos" }, colSpan: 3, isRequired: !ro, editorType: "dxHtmlEditor",
            editorOptions: decisiones.editorDescripcion(260) },
          { dataField: "notificados", label: { text: "Notificados: personas que estarán al tanto de la decisión (solo la ven)" }, colSpan: 3, editorType: "dxTagBox",
            visible: borrador, editorOptions: { items: us.map(u => ({ id: u.usuarioId, t: u.nombre + " (" + u.usuario + ")" })), valueExpr: "id", displayExpr: "t",
              searchEnabled: true, showSelectionControls: true, applyValueMode: "useButtons", placeholder: "Elija los usuarios…" } }
        ],
        extra: $x => {
          if (!d) return pb.ui.mdNote($x, "Al guardarla en borrador se toman los aprobadores de su tipo; luego puede agregar más aprobadores y los archivos de respaldo y, cuando esté lista, enviarla a aprobación.");
          const $m = $('<div class="card pad stack">').appendTo($x);
          decisiones.detalle($m, d, acciones(d, refrescar), refrescar, x);
        },
        alGuardar: async f => {
          if (!f.tipo) return pb.notify("Configure primero un tipo de decisión activo (Decisiones › Tipos de decisión)", "warning");
          const r = await pb.post(url("Guardar", d ? "token=" + d.token : ""), { tipo: f.tipo, titulo: f.titulo, descripcion: f.descripcion,
            area: f.area, fecha: decisiones.iso(f.fecha), notificados: f.notificados || [] });
          if (r === undefined) return;
          pb.notify("Decisión guardada en borrador"); ficha(r.token, "consulta");
        },
        alEditar: () => editable ? ficha(token, "edicion") : pb.notify("Solo se edita en borrador y la edita quien la registró", "warning"),
        alVolver: listado
      });
    }

    listado();
  });
</script>
}
