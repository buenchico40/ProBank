@{ ViewData["Title"] = "Bases de datos"; ViewData["Opcion"] = "conexiones"; }
@section Scripts {
<script src="~/js/consultas.js" asp-append-version="true"></script>
<script>
  // SQL-02: bases de datos donde se ejecutan las consultas. La cadena de conexión vive en Key Vault (aquí solo el nombre del
  // secreto): se lee en el servidor al ejecutar y nunca viaja al navegador.
  pb.listo.then(() => {
    const $c = $("#content"), url = cq.url;
    let lista = null;
    const AUT = ["Usuario SQL de solo lectura", "Identidad administrada (Entra ID)"];

    function listado() {
      $c.empty();
      lista = pb.ui.grid({
        $c, modulo: "Consultas dinámicas", titulo: "Bases de datos", opcion: "conexiones", clave: "codigo",
        cargar: () => pb.get(url("Conexiones")),
        columnas: [
          { campo: "codigo", titulo: "Código" }, { campo: "nombre", titulo: "Nombre" }, { campo: "servidor", titulo: "Servidor", valor: x => cq.corte(x.servidor) },
          { campo: "baseDatos", titulo: "Base de datos" }, { campo: "autenticacion", titulo: "Autenticación" },
          { campo: "secretoKeyVault", titulo: "Cadena de conexión", valor: x => "•••••••• en Key Vault (" + x.secretoKeyVault + ")" },
          { campo: "consultas", titulo: "Consultas" }, { campo: "estado", titulo: "Estado", pill: true }
        ],
        anulada: x => x.estado === "Inactivo",
        botones: [
          { text: "Nuevo", icon: "add", type: "default", accion: "crear", onClick: () => ficha(null, "nuevo") },
          { text: "Editar", icon: "edit", accion: "editar", fila: true, onClick: x => ficha(x, "edicion") },
          { text: "Eliminar", icon: "trash", accion: "eliminar", fila: true, onClick: eliminar },
          { text: "Probar conexión", icon: "refresh", accion: "editar", fila: true, onClick: probar }
        ],
        alAbrir: x => ficha(x, "consulta"),
        detalle: async ($e, x) => {
          pb.ui.mdHead($e, [x.codigo, x.nombre, x.servidor + " / " + x.baseDatos, x.autenticacion], x.estado);
          pb.ui.mdNote($e, "Cadena de conexión: guardada en Key Vault como «" + x.secretoKeyVault + "». Se lee solo en el servidor al ejecutar; nunca viaja al navegador.");
          const d = await pb.get(url("Conexion", "codigo=" + encodeURIComponent(x.codigo)));
          if (!d) return;
          pb.ui.mdGrid($e, "Consultas que pueden usarla", [["c", "Consulta"], ["n", "Nombre"], ["s", "Estado"]],
            d.consultas.map(q => ({ c: q.codigo, n: q.nombre, s: q.estado })), "Ninguna consulta la usa.");
          if (pb.can("conexiones", "editar")) pb.ui.mdActions($e, [{ text: "Probar conexión", icon: "refresh", type: "default", onClick: () => probar(x) }]);
        }
      });
    }

    async function probar(x) {
      if (x.estado !== "Activo") return pb.notify("La base " + x.codigo + " está inactiva", "warning");
      pb.notify("Probando la conexión a " + x.baseDatos + "…", "info");
      const r = await pb.post(url("ProbarConexion", "codigo=" + encodeURIComponent(x.codigo)));
      if (r) pb.notify(x.codigo + " · " + r.mensaje, r.exitosa ? "success" : "error");
    }

    async function eliminar(x) {
      if (!await pb.ui.confirmar("Eliminar base de datos", "¿Desea eliminar <b>" + pb.esc(x.codigo + " · " + x.nombre) + "</b>? Si alguna consulta o ejecución la usa, desactívela en su lugar.", "Eliminar", "danger", "trash")) return;
      const r = await pb.post(url("EliminarConexion", "codigo=" + encodeURIComponent(x.codigo)));
      if (r !== undefined) { pb.notify(r); lista.recargar(); }
    }

    function ficha(x, modo) {
      const datos = x ? Object.assign({}, x) : { codigo: "(se asigna al guardar)", nombre: "", servidor: "", baseDatos: "", autenticacion: AUT[0], secretoKeyVault: "", estado: "Activo" };
      pb.ui.detalle({
        $c, modulo: "Consultas dinámicas", titulo: "Bases de datos", modo, nombre: x && x.codigo, token: x && x.codigo, datos,
        soloLectura: modo === "consulta" && !pb.can("conexiones", "editar"),
        items: ro => [
          { dataField: "codigo", label: { text: "Código (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "nombre", label: { text: "Nombre" }, isRequired: !ro, editorOptions: { maxLength: 150 } },
          { dataField: "estado", label: { text: "Estado" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: ["Activo", "Inactivo"] } },
          { dataField: "servidor", label: { text: "Servidor" }, isRequired: !ro, editorOptions: { maxLength: 200, placeholder: "sqlcore-ro.banco.local" } },
          { dataField: "baseDatos", label: { text: "Base de datos" }, isRequired: !ro, editorOptions: { maxLength: 128 } },
          { dataField: "autenticacion", label: { text: "Autenticación" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: AUT } },
          { dataField: "secretoKeyVault", label: { text: "Secreto de Key Vault con la cadena de conexión" }, isRequired: !ro, colSpan: 2,
            helpText: "Solo el nombre del secreto: empieza con cnx- (letras, números y guiones). Operaciones carga la cadena en Key Vault; ProBank nunca la guarda ni la muestra.",
            editorOptions: { maxLength: 127, placeholder: "cnx-core-lectura" } }
        ],
        alGuardar: async f => {
          const r = await pb.post(url("GuardarConexion", x ? "codigo=" + encodeURIComponent(x.codigo) : ""),
            { nombre: f.nombre, servidor: f.servidor, baseDatos: f.baseDatos, autenticacion: f.autenticacion, secretoKeyVault: f.secretoKeyVault, estado: f.estado });
          if (r === undefined) return;
          pb.notify("Base de datos " + r + " guardada" + (x ? "" : ": pruebe la conexión para verificar el secreto")); listado();
        },
        alEditar: () => ficha(x, "edicion"),
        alVolver: listado
      });
    }

    listado();
  });
</script>
}
