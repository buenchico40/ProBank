@{ ViewData["Title"] = "Comunicados"; ViewData["Opcion"] = "comunicados"; }
@section Scripts {
<script src="~/js/marketing.js" asp-append-version="true"></script>
<script>
  // MKT-02: comunicados del Panel con contenido estructurado (resumen, secciones y contacto), tipo, vigencia, audiencia y destacado.
  // Borrador → Publicar (programado, vigente o vencido según las fechas) → Retirar. Solo se eliminan borradores.
  pb.listo.then(() => {
    const $c = $("#content"), url = mkt.url;
    const iso = v => { if (!v) return null; const x = v instanceof Date ? v : pb.aFecha(v); return x.getFullYear() + "-" + String(x.getMonth() + 1).padStart(2, "0") + "-" + String(x.getDate()).padStart(2, "0"); };
    let lista = null, audiencias = null;
    const cargarAudiencias = async () => audiencias || (audiencias = (await pb.get(url("Audiencias"))) || ["Todos"]);

    function listado() {
      $c.empty();
      lista = pb.ui.grid({
        $c, modulo: "Marketing", titulo: "Comunicados", opcion: "comunicados", clave: "token",
        cargar: () => pb.get(url("Comunicados")),
        columnas: [
          { campo: "codigo", titulo: "Código" }, { campo: "titulo", titulo: "Título" }, { campo: "tipo", titulo: "Tipo" },
          { campo: "desde", titulo: "Publicado desde", formato: "fecha" }, { campo: "hasta", titulo: "Publicado hasta", formato: "fecha" },
          { campo: "audiencia", titulo: "Audiencia" }, { campo: "destacado", titulo: "Destacado", valor: m => m.destacado ? "Sí" : "No" },
          { campo: "estado", titulo: "Estado", pill: true }
        ],
        anulada: m => m.estado === "Retirado",
        botones: [
          { text: "Nuevo", icon: "add", type: "default", accion: "crear", onClick: () => ficha(null, "nuevo") },
          { text: "Editar", icon: "edit", accion: "editar", fila: true, onClick: m => ficha(m.token, "edicion") },
          { text: "Eliminar", icon: "trash", accion: "eliminar", fila: true, onClick: eliminar },
          { text: "Publicar", icon: "upload", accion: "aprobar", fila: true, onClick: publicar },
          { text: "Retirar", icon: "clear", accion: "aprobar", fila: true, onClick: retirar }
        ],
        alAbrir: m => ficha(m.token, "consulta"),
        detalle: ($e, m) => {
          pb.ui.mdHead($e, [m.codigo, m.titulo, m.tipo, mkt.vigencia(m), "Audiencia: " + m.audiencia, m.destacado ? "Destacado" : ""].filter(Boolean), m.estado);
          const texto = (new DOMParser().parseFromString(m.contenidoHtml || "", "text/html").body.textContent || "").trim();
          pb.ui.mdGrid($e, "Contenido", [["s", "Sección"], ["x", "Texto"]],
            [{ s: "Resumen", x: m.resumen }, { s: "Secciones", x: texto ? (texto.length > 300 ? texto.substring(0, 297) + "…" : texto) : "—" }, { s: "Consultas", x: m.contacto || "—" }]);
          const acc = [{ text: "Vista previa", icon: "find", type: "default", onClick: () => mkt.leer(m) }];
          if (pb.can("comunicados", "aprobar") && ["Borrador", "Retirado"].indexOf(m.estado) >= 0) acc.push({ text: "Publicar", icon: "upload", onClick: () => publicar(m) });
          if (pb.can("comunicados", "aprobar") && ["Publicado", "Programado", "Vencido"].indexOf(m.estado) >= 0) acc.push({ text: "Retirar", icon: "clear", onClick: () => retirar(m) });
          pb.ui.mdActions($e, acc);
          pb.ui.mdNote($e, "Se muestra en el Panel durante su vigencia a la audiencia elegida; los destacados van primero.");
        }
      });
    }

    async function publicar(m) {
      if (["Publicado", "Programado"].indexOf(m.estado) >= 0) return pb.notify(m.codigo + " ya está publicado", "warning");
      if (!m.desde || !m.hasta) return pb.notify("Defina la vigencia (desde y hasta) antes de publicar", "warning");
      const r = await pb.post(url("PublicarComunicado", "token=" + m.token));
      if (r !== undefined) { pb.notify(r); lista.recargar(); }
    }

    async function retirar(m) {
      if (["Publicado", "Programado", "Vencido"].indexOf(m.estado) < 0) return pb.notify("Solo se retira lo publicado", "warning");
      if (!await pb.ui.confirmar("Retirar comunicado", "¿Desea retirar <b>" + pb.esc(m.codigo) + "</b>? Deja de mostrarse en el Panel de inmediato.", "Retirar", "danger", "clear")) return;
      const r = await pb.post(url("RetirarComunicado", "token=" + m.token));
      if (r !== undefined) { pb.notify(m.codigo + " retirado: deja de mostrarse en el Panel"); lista.recargar(); }
    }

    async function eliminar(m) {
      if (m.estado !== "Borrador") return pb.notify("Solo se eliminan borradores; lo publicado se retira", "warning");
      if (!await pb.ui.confirmar("Eliminar comunicado", "¿Desea eliminar <b>" + pb.esc(m.codigo) + "</b>? Esta acción no se puede deshacer.", "Eliminar", "danger", "trash")) return;
      if (await pb.post(url("EliminarComunicado", "token=" + m.token)) !== undefined) { pb.notify("Registro " + m.codigo + " eliminado"); lista.recargar(); }
    }

    async function ficha(token, modo) {
      const [d, auds] = await Promise.all([token ? pb.get(url("Comunicado", "token=" + token)) : null, cargarAudiencias()]);
      if (token && !d) return;
      const datos = d ? { codigo: d.codigo, titulo: d.titulo, tipo: d.tipo, desde: d.desde ? pb.aFecha(d.desde) : null, hasta: d.hasta ? pb.aFecha(d.hasta) : null,
                          audiencia: d.audiencia, destacado: d.destacado, resumen: d.resumen, contacto: d.contacto || "", estado: d.estado,
                          publicado: d.publicadoPor ? d.publicadoPor + " · " + pb.fechaHora(d.fechaPublicacion) : "—" }
                      : { codigo: "(se asigna al guardar)", titulo: "", tipo: "Aviso", desde: null, hasta: null, audiencia: "Todos", destacado: false,
                          resumen: "", contacto: "", estado: "Borrador", publicado: "—" };
      let editor = null;
      pb.ui.detalle({
        $c, modulo: "Marketing", titulo: "Comunicados", modo, nombre: d && d.codigo, token: d && d.token, datos,
        soloLectura: modo === "consulta" && !pb.can("comunicados", "editar"),
        items: ro => [
          { dataField: "codigo", label: { text: "Código (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "titulo", label: { text: "Título" }, isRequired: !ro, editorOptions: { maxLength: 200 } },
          { dataField: "tipo", label: { text: "Tipo" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: mkt.TIPOS } },
          { dataField: "desde", label: { text: "Publicado desde" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" } },
          { dataField: "hasta", label: { text: "Publicado hasta" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" },
            validationRules: [{ type: "custom", message: "No puede ser anterior al inicio", validationCallback: o => !o.value || !datos.desde || o.value >= datos.desde }] },
          { dataField: "audiencia", label: { text: "Audiencia" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: auds, searchEnabled: true } },
          { dataField: "destacado", label: { text: "Destacado (va primero en el Panel)" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Sí", switchedOffText: "No" } },
          { dataField: "estado", label: { text: "Estado (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "publicado", label: { text: "Publicado por (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "resumen", label: { text: "Resumen (lo que se ve en la tarjeta del Panel)" }, colSpan: 3, isRequired: !ro, editorType: "dxTextArea",
            editorOptions: { height: 60, maxLength: 300 } },
          { dataField: "contacto", label: { text: "Contacto para consultas" }, colSpan: 3, editorOptions: { maxLength: 150, placeholder: "Por ejemplo: Mesa de servicio · Ext. 1000" } }
        ],
        extra: ($x, ro) => {
          const $rc = $('<div class="card pad stack">').appendTo($x);
          $rc.append('<span class="lbl" id="richLbl">Contenido del comunicado (secciones)</span>');
          $rc.append($('<p class="muted" style="margin:0">').text("Use títulos o negritas para cada sección (por ejemplo: Qué pasará, Cuándo, Qué debe hacer)."));
          editor = $("<div>").appendTo($rc).dxHtmlEditor({ value: d ? d.contenidoHtml || "" : "", readOnly: ro, height: 220, elementAttr: { "aria-labelledby": "richLbl" },
            toolbar: { multiline: true, items: [{ name: "header", acceptedValues: [false, 3] }, "separator", "bold", "italic", "underline", "separator", "bulletList", "orderedList", "separator", "link"] } }).dxHtmlEditor("instance");
          if (d) pb.ui.mdActions($rc, [{ text: "Vista previa", icon: "find", onClick: () => mkt.leer(Object.assign({}, d, { contenidoHtml: editor.option("value") })) }]);
        },
        alGuardar: async f => {
          const g = await pb.post(url("GuardarComunicado", d ? "token=" + d.token : ""), { titulo: f.titulo, tipo: f.tipo, resumen: f.resumen, contenidoHtml: editor.option("value") || null,
            contacto: f.contacto || null, desde: iso(f.desde), hasta: iso(f.hasta), audiencia: f.audiencia, destacado: !!f.destacado });
          if (g === undefined) return;
          pb.notify("Registro guardado correctamente"); listado();
        },
        alEditar: () => ficha(token, "edicion"),
        alVolver: listado
      });
    }

    listado();
  });
</script>
}
