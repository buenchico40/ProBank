@{ ViewData["Title"] = "Secretos"; ViewData["Opcion"] = "secretos"; }
@section Scripts {
<script src="~/js/boveda.js" asp-append-version="true"></script>
<script>
  // CRE-01 a CRE-03: secretos (cadenas de conexión, claves de API, secretos de cliente, tokens SAS) con versión, expiración y aviso
  // (Vigente, Por vencer, Vencido o Inactivo). El valor va cifrado con Always Encrypted y solo lo ven los miembros de su grupo.
  pb.listo.then(() => {
    const $c = $("#content"), url = boveda.url;
    const TIPOS = ["Cadena de conexión", "Clave de API", "Secreto de cliente (Entra ID)", "Token SAS"], AVISOS = [7, 15, 30, 45, 60];
    const iso = v => { if (!v) return null; const x = v instanceof Date ? v : pb.aFecha(v); return x.getFullYear() + "-" + String(x.getMonth() + 1).padStart(2, "0") + "-" + String(x.getDate()).padStart(2, "0"); };
    let lista = null;

    function listado() {
      $c.empty();
      lista = pb.ui.grid({
        $c, modulo: "Bóveda", titulo: "Secretos", opcion: "secretos", clave: "token",
        cargar: () => pb.get(url("Secretos")),
        columnas: [
          { campo: "nombre", titulo: "Secreto", ancho: 230 }, { campo: "tipo", titulo: "Tipo" }, { campo: "almacen", titulo: "Almacén" }, { campo: "sistema", titulo: "Sistema" },
          { campo: "version", titulo: "Versión", valor: x => x.version ? "v" + x.version : "—" }, { campo: "ultimaRotacion", titulo: "Última rotación", formato: "fecha" },
          { campo: "expira", titulo: "Expira", formato: "fecha" }, { campo: "diasParaVencer", titulo: "Días para vencer", valor: x => boveda.dias(x.diasParaVencer) },
          { campo: "diasAviso", titulo: "Avisar con (días)" }, { campo: "estado", titulo: "Estado", pill: true }, { campo: "grupoCodigo", titulo: "Grupo de acceso" }
        ],
        anulada: x => !x.activo,
        botones: [
          { text: "Nuevo", icon: "add", type: "default", accion: "crear", onClick: () => ficha(null, "nuevo") },
          { text: "Editar", icon: "edit", accion: "editar", fila: true, onClick: x => ficha(x.token, "edicion") },
          { text: "Cambiar credencial", icon: "key", type: "default", accion: "editar", fila: true, onClick: x => boveda.cambiar("secretos", x, () => lista.recargar()) }
        ],
        alAbrir: x => ficha(x.token, "consulta"),
        detalle: async ($e, x) => {
          pb.ui.mdHead($e, [x.nombre, x.tipo, x.almacen, x.sistema, x.expira ? "Expira " + pb.fecha(x.expira) + " (" + boveda.dias(x.diasParaVencer) + ")" : "Sin expiración"], x.estado);
          const $v = $("<div>").appendTo($e), $p = $("<div>").appendTo($e);
          const h = await boveda.panel($p, "secretos", x, () => lista.recargar());
          if (h) pb.ui.mdGrid($v, "Versiones", [["v", "Versión"], ["c", "Creada"], ["e", "Expira"], ["u", "Registrado por"], ["s", "Estado"]],
            h.versiones.map(v => ({ v: "v" + v.version, c: pb.fechaHora(v.fecha), e: pb.fecha(v.vence), u: v.registradoPor, s: v.vigente ? x.estado : "Inactivo" })),
            "Aún no se ha guardado el valor.");
        }
      });
    }

    async function ficha(token, modo) {
      const [d, grupos] = await Promise.all([token ? pb.get(url("Secreto", "token=" + token)) : null, pb.get(url("Grupos"))]);
      if (token && !d) return;
      const activos = (grupos || []).filter(g => g.estado === "Activo" || (d && g.token === d.grupoToken)).map(g => ({ id: g.token, t: g.codigo + " · " + g.nombre }));
      const datos = d ? { nombre: d.nombre, tipo: d.tipo, almacen: d.almacen, sistema: d.sistema, grupo: d.grupoToken, diasAviso: d.diasAviso,
                          expira: d.expira ? pb.aFecha(d.expira) : null, activo: d.activo, estado: d.estado, version: d.version ? "v" + d.version : "—",
                          ultima: pb.fecha(d.ultimaRotacion) }
                      : { nombre: "", tipo: TIPOS[0], almacen: "", sistema: "", grupo: null, diasAviso: 30, expira: null, activo: true, estado: "—", version: "—", ultima: "—" };
      pb.ui.detalle({
        $c, modulo: "Bóveda", titulo: "Secretos", modo, nombre: d && d.nombre, token: d && d.token, datos,
        soloLectura: modo === "consulta" && !pb.can("secretos", "editar"),
        items: ro => [
          { dataField: "nombre", label: { text: "Secreto" }, isRequired: !ro, editorOptions: { maxLength: 150, placeholder: "Por ejemplo: ConnectionStrings--ProBankDb" } },
          { dataField: "tipo", label: { text: "Tipo" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: TIPOS } },
          { dataField: "almacen", label: { text: "Almacén" }, isRequired: !ro, editorOptions: { maxLength: 100, placeholder: "Por ejemplo: kv-probank-prd" } },
          { dataField: "sistema", label: { text: "Sistema" }, isRequired: !ro, editorOptions: { maxLength: 150 } },
          { dataField: "grupo", label: { text: "Grupo de acceso (quién ve el valor)" }, editorType: "dxSelectBox", isRequired: !ro,
            editorOptions: { items: activos, valueExpr: "id", displayExpr: "t", searchEnabled: true } },
          { dataField: "diasAviso", label: { text: "Avisar con (días)" }, editorType: "dxSelectBox", isRequired: !ro, editorOptions: { items: AVISOS } },
          { dataField: "expira", label: { text: "Expira" }, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy", showClearButton: true } },
          { dataField: "activo", label: { text: "Activo" }, editorType: "dxSwitch", editorOptions: { switchedOnText: "Sí", switchedOffText: "No" } },
          { dataField: "version", label: { text: "Versión (calculada)" }, editorOptions: { readOnly: true } },
          { dataField: "ultima", label: { text: "Última rotación (calculada)" }, editorOptions: { readOnly: true } },
          { dataField: "estado", label: { text: "Estado (calculado)" }, editorOptions: { readOnly: true } }
        ],
        extra: $x => {
          if (!d) return pb.ui.mdNote($x, "Guarde el secreto para registrar su valor: se cifra con Always Encrypted y solo lo ven los miembros del grupo.");
          const $cp = $('<div class="card pad stack">').appendTo($x);
          $cp.append("<h2>Credencial</h2>");
          boveda.panel($cp, "secretos", d, () => ficha(token, modo));
        },
        alGuardar: async f => {
          const r = await pb.post(url("GuardarSecreto", d ? "token=" + d.token : ""), { nombre: f.nombre, tipo: f.tipo, almacen: f.almacen, sistema: f.sistema,
            grupo: f.grupo, diasAviso: f.diasAviso, expira: iso(f.expira), activo: !!f.activo });
          if (r === undefined) return;
          pb.notify("Secreto guardado correctamente");
          if (!d) return ficha(r.token, "consulta");
          listado();
        },
        alEditar: () => ficha(token, "edicion"),
        alVolver: listado
      });
    }

    listado();
  });
</script>
}
