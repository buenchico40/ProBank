@{ ViewData["Title"] = "Informes de seguimiento"; ViewData["Opcion"] = "informes"; }
@section Scripts {
<script src="~/js/portafolio.js" asp-append-version="true"></script>
<script>
  // Informes de seguimiento semanales o mensuales con la bitácora de tareas y los acuerdos del periodo.
  pb.listo.then(() => {
    const $c = $("#content");
    let lista = null;
    const periodo = i => i.tipo === "Mensual" && pb.aFecha(i.desde).getDate() === 1
      ? pb.aFecha(i.desde).toLocaleDateString("es-EC", { month: "long", year: "numeric" }).replace(/^./, x => x.toUpperCase())
      : pb.fecha(i.desde) + " – " + pb.fecha(i.hasta);

    lista = pb.ui.grid({
      $c, modulo: "Portafolio", titulo: "Informes de seguimiento", opcion: "informes", clave: "informeId",
      cargar: () => pb.get(pry.url("Informes")),
      columnas: [
        { campo: "codigo", titulo: "Informe" }, { campo: "periodo", titulo: "Periodo", valor: periodo }, { campo: "tipo", titulo: "Tipo" },
        { campo: "incluye", titulo: "Incluye" }, { campo: "estado", titulo: "Estado", pill: true }
      ],
      botones: [
        { text: "Nuevo", icon: "add", type: "default", accion: "crear", onClick: () => periodoPopup(null) },
        { text: "Editar", icon: "edit", accion: "editar", fila: true, onClick: periodoPopup },
        { text: "Generar informe", icon: "textdocument", accion: "generar", fila: true, onClick: generar }
      ],
      alAbrir: i => i.estado === "Completado" ? ver(i) : pb.notify("Genere el informe para verlo", "info"),
      detalle: async ($e, i) => {
        pb.ui.mdHead($e, [i.codigo, periodo(i), i.tipo, "Incluye " + i.incluye.toLowerCase()].concat(i.fechaGenerado ? ["Generado el " + pb.fechaHora(i.fechaGenerado) + " por " + i.generadoPor] : []), i.estado);
        const r = await pb.get(pry.url("ResumenInforme", "id=" + i.informeId));
        if (r) pb.ui.mdGrid($e, "Bitácora y acuerdos del periodo", [["i", "Ítem"], ["b", "Bitácora"], ["ac", "Acuerdos"], ["s", "Estado"]],
          r.map(x => ({ i: x.item, b: x.tareasConMovimiento + " tarea(s) con movimiento · avance " + x.avance + " %", ac: x.acuerdos + (x.cumplidos ? " (" + x.cumplidos + " cumplido)" : "") + (x.vencidos ? " · " + x.vencidos + " vencido(s)" : ""), s: x.estado })),
          "Sin actividad en el periodo.");
        // Generar arma el PDF y lo abre; uno ya generado se vuelve a ver con el enlace de su código
        if (pb.can("informes", "generar")) pb.ui.mdActions($e, [{ text: "Generar informe", icon: "textdocument", type: "default", onClick: () => generar(i) }]);
      }
    });

    function periodoPopup(i) {
      const hoy = pry.hoy(), lunes = new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate() - ((hoy.getDay() + 6) % 7));
      const data = i ? { tipo: i.tipo, desde: pb.aFecha(i.desde), hasta: pb.aFecha(i.hasta) } : { tipo: "Semanal", desde: lunes, hasta: new Date(lunes.getFullYear(), lunes.getMonth(), lunes.getDate() + 4) };
      let form;
      const sugerir = () => {
        const d = data.desde || hoy;
        if (data.tipo === "Mensual") { form.updateData("desde", new Date(d.getFullYear(), d.getMonth(), 1)); form.updateData("hasta", new Date(d.getFullYear(), d.getMonth() + 1, 0)); }
        else { const l = new Date(d.getFullYear(), d.getMonth(), d.getDate() - ((d.getDay() + 6) % 7)); form.updateData("desde", l); form.updateData("hasta", new Date(l.getFullYear(), l.getMonth(), l.getDate() + 4)); }
      };
      pb.ui.openPopup(i ? "Editar periodo · " + i.codigo : "Nuevo informe de seguimiento", $f => (form = $("<div>").appendTo($f).dxForm({ formData: data, labelLocation: "top", showColonAfterLabel: false, colCount: 2, items: [
        { dataField: "tipo", label: { text: "Tipo" }, colSpan: 2, editorType: "dxRadioGroup", editorOptions: { items: ["Semanal", "Mensual"], layout: "horizontal", onValueChanged: () => setTimeout(sugerir, 0) } },
        { dataField: "desde", label: { text: "Desde" }, isRequired: true, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" } },
        { dataField: "hasta", label: { text: "Hasta" }, isRequired: true, editorType: "dxDateBox", editorOptions: { displayFormat: "dd/MM/yyyy" },
          validationRules: [{ type: "custom", message: "No puede ser anterior al inicio", validationCallback: o => !o.value || o.value >= data.desde }] },
        { colSpan: 2, template: () => $('<p class="muted" style="margin:0">').text("Incluye la bitácora de tareas y los acuerdos semanales del periodo." + (i ? " Cambiar el periodo devuelve el informe a Borrador." : "")) }
      ] }).dxForm("instance")), async f => {
        if (!f.validate().isValid) return false;
        const r = await pb.post(pry.url("GuardarInforme", i ? "id=" + i.informeId : ""), { tipo: data.tipo, desde: pry.iso(data.desde), hasta: pry.iso(data.hasta) });
        if (r === undefined) return false;
        pb.notify(i ? "Informe " + i.codigo + " actualizado" : "Informe registrado como borrador"); lista.recargar();
      }, "Guardar", 480);
    }

    async function generar(i) {
      const r = await pb.post(pry.url("GenerarInforme", "id=" + i.informeId));
      if (r === undefined) return;
      pb.notify(r); await lista.recargar(); ver(i);
    }

    // El informe es un PDF de DevExpress Reporting (gráficos y luego el detalle) que la API guarda al generarlo
    async function ver(i) {
      const d = await pb.get(pry.url("Informe", "id=" + i.informeId));
      if (!d) return;
      if (!d.tienePdf) return pb.notify("Genere el informe " + d.codigo + " para obtener su PDF", "info");
      const pdf = q => pry.url("InformePdf", "id=" + d.informeId + q);
      pb.ui.openPopup(d.codigo + " · " + periodo(d), $f => {
        $("<iframe>").attr({ src: pdf(""), title: "Informe " + d.codigo })
          .css({ width: "100%", height: "min(72vh, 760px)", border: "1px solid var(--line)", borderRadius: "8px", background: "#fff" }).appendTo($f);
        return null;
      }, () => true, "Cerrar", 1100, { extra: [
        { text: "Descargar PDF", icon: "download", onClick: () => { window.location.href = pdf("&descargar=true"); } },
        { text: "Abrir en otra pestaña", icon: "export", onClick: () => window.open(pdf(""), "_blank") }
      ] });
    }
  });
</script>
}
