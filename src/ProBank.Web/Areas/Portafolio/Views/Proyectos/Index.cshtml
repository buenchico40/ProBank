@{ ViewData["Title"] = "Proyectos, mejoras y bugs"; ViewData["Opcion"] = "proyectos"; }
@section Scripts {
<script src="~/js/portafolio.js" asp-append-version="true"></script>
<script>
  // PRY-01, PRY-02 y PRY-06: ítems de TI con responsables, hitos, tareas y acuerdos; avance = tareas completadas ÷ total.
  pb.listo.then(() => {
    const $c = $("#content");
    let lista = null;

    function listado() {
      $c.empty();
      lista = pb.ui.grid({
        $c, modulo: "Portafolio", titulo: "Proyectos, mejoras y bugs", opcion: "proyectos", clave: "token",
        cargar: () => pb.get(pry.url("Items", "abiertos=false")),
        columnas: [
          { campo: "codigo", titulo: "Código" }, { campo: "titulo", titulo: "Título" }, { campo: "tipo", titulo: "Tipo" },
          { campo: "responsables", titulo: "Responsables" },
          { campo: "avance", titulo: "Avance", valor: i => i.avance + " % (" + i.completadas + " de " + i.tareas + ")" },
          { campo: "estado", titulo: "Estado", pill: true }
        ],
        anulada: i => i.estado === "Anulado",
        botones: [
          { text: "Nuevo", icon: "add", type: "default", accion: "crear", onClick: () => ficha(null, "nuevo") },
          { text: "Editar", icon: "edit", accion: "editar", fila: true, onClick: i => ficha(i.token, "edicion") },
          { text: "Eliminar", icon: "trash", accion: "eliminar", fila: true, onClick: eliminar },
          { text: "Registrar acuerdo semanal", icon: "comment", onClick: i => pry.acuerdoPopup(lista.seleccion() && lista.seleccion().token, () => lista.recargar()), visible: pb.can("acuerdos", "crear") }
        ].filter(b => b.visible !== false),
        alAbrir: i => ficha(i.token, "consulta"),
        detalle: async ($e, i) => {
          const resp = String(i.responsables || "").split(", ").filter(Boolean);
          pb.ui.mdHead($e, [i.codigo, i.titulo, i.tipo, (resp.length > 1 ? "Responsables: " : "Responsable: ") + (resp.join(", ") || "—"), "Avance " + i.avance + " %"], i.estado);
          const [d, ts] = await Promise.all([pb.get(pry.url("Item", "token=" + i.token)), pb.get(pry.url("Tareas", "item=" + i.token))]);
          if (!d || !ts) return;
          pb.ui.mdGrid($e, "Responsables", [["n", "Nombre"], ["u", "Usuario"], ["ro", "Roles"]], d.responsables.map(r => ({ n: r.nombre, u: r.usuario, ro: r.roles })), "Sin responsables asignados.");
          pry.tareasDelItem($("<div>").appendTo($e), ts, "Tareas del ítem");
          pb.ui.mdGrid($e, "Acuerdos de la revisión semanal", [["rv", "Revisión"], ["ac", "Acuerdo"], ["re", "Responsable"], ["fc", "Fecha de cumplimiento"], ["s", "Estado"]],
            d.acuerdos.map(a => ({ rv: pb.fecha(a.fechaRevision), ac: a.descripcion, re: a.responsable, fc: pb.fecha(a.fechaCumplimiento), s: a.estado })), "Sin acuerdos registrados.");
          $e.append($('<div class="mdtitle">').text("Documentos adjuntos"));
          pry.adjuntos($("<div>").appendTo($e), { ambito: "Item", token: i.token, editable: false });
          const abierto = ["Completado", "Anulado"].indexOf(i.estado) < 0;
          pb.ui.mdActions($e, [
            { text: "Nueva tarea", icon: "add", type: "default", disabled: !abierto || i.estado === "Borrador" || !pb.can("tareas", "crear"), onClick: () => pry.tareaPopup(i.token, () => lista.recargar()) },
            { text: "Registrar acuerdo semanal", icon: "comment", disabled: !abierto || i.estado === "Borrador" || !pb.can("acuerdos", "crear"), onClick: () => pry.acuerdoPopup(i.token, () => lista.recargar()) },
            { text: "Ver en cronograma", icon: "event", disabled: !pb.can("gantt", "ver"), onClick: () => { location.href = "/Portafolio/Cronograma?item=" + i.token; } }
          ]);
          const motivo = pry.motivoSinTareas(i.estado);
          if (motivo) pb.ui.mdNote($e, motivo);
        }
      });
    }

    async function eliminar(i) {
      if (i.estado !== "Borrador") return pb.notify("Solo se pueden eliminar borradores", "warning");
      if (!await pb.ui.confirmar("Eliminar registro", "¿Desea eliminar el registro <b>" + pb.esc(i.codigo) + "</b>? Esta acción no se puede deshacer.", "Eliminar", "danger", "trash")) return;
      if (await pb.post(pry.url("EliminarItem", "token=" + i.token)) !== undefined) { pb.notify("Registro " + i.codigo + " eliminado"); lista.recargar(); }
    }

    async function ficha(token, modo) {
      const [d, users, ts] = await Promise.all([token ? pb.get(pry.url("Item", "token=" + token)) : null, pry.usuarios(), token ? pb.get(pry.url("Tareas", "item=" + token)) : []]);
      if (token && (!d || !ts)) return;
      const avance = ts.length ? Math.round(ts.filter(t => t.estado === "Completada").length / ts.length * 100) : 0;
      const datos = d ? { codigo: d.codigo, titulo: d.titulo, tipo: d.tipo, responsables: d.responsables.map(r => r.usuarioId), estado: d.estado, avance: avance + " % (" + ts.filter(t => t.estado === "Completada").length + " de " + ts.length + " tareas)", registrado: (d.creadoPor || "—") + " · " + pb.fechaHora(d.fechaRegistro) }
                      : { codigo: "(se asigna al guardar)", titulo: "", tipo: "Proyecto", responsables: [], estado: "Borrador", avance: "—", registrado: pb.sesion.nombre };
      let editor = null, docs = null, hitos = d ? d.hitos.map(h => Object.assign({ id: h.hitoId }, h, { fechaInicio: h.fechaInicio ? pb.aFecha(h.fechaInicio) : null, fechaFin: h.fechaFin ? pb.aFecha(h.fechaFin) : null })) : [], gHitos = null;
      pb.ui.detalle({
        $c, modulo: "Portafolio", titulo: "Proyectos, mejoras y bugs", modo, nombre: d && d.codigo, token: d && d.token, datos,
        soloLectura: modo === "consulta" && !pb.can("proyectos", "editar"),
        items: ro => [
          { dataField: "codigo", label: { text: "Código (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "titulo", label: { text: "Título" }, isRequired: !ro, editorOptions: { maxLength: 200 } },
          { dataField: "tipo", label: { text: "Tipo" }, editorType: "dxSelectBox", editorOptions: { items: ["Proyecto", "Mejora", "Bug"] } },
          { dataField: "responsables", label: { text: "Responsables (uno o varios)" }, isRequired: !ro, editorType: "dxTagBox",
            editorOptions: { dataSource: users, valueExpr: "usuarioId", displayExpr: "nombre", showSelectionControls: true, applyValueMode: "instantly", searchEnabled: true, placeholder: "Seleccione uno o varios responsables" } },
          { dataField: "estado", label: { text: "Estado" }, editorType: "dxSelectBox", editorOptions: { items: ["Borrador", "Pendiente", "En curso", "En revisión", "Completado", "Anulado"] } },
          { dataField: "avance", label: { text: "Avance (calculado)" }, editorOptions: { readOnly: true } },
          { dataField: "registrado", label: { text: "Registrado por" }, editorOptions: { readOnly: true } }
        ],
        extra: ($x, ro) => {
          const $rc = $('<div class="card pad stack">').appendTo($x);
          $rc.append('<span class="lbl" id="richLbl">Descripción</span>');
          editor = $("<div>").appendTo($rc).dxHtmlEditor({ value: d ? d.descripcionHtml || "" : "", readOnly: ro, height: 160, elementAttr: { "aria-labelledby": "richLbl" },
            toolbar: { multiline: true, items: ["bold", "italic", "underline", "separator", "bulletList", "orderedList", "separator", "link"] } }).dxHtmlEditor("instance");
          const $dc = $('<div class="card pad stack">').appendTo($x);
          $dc.append("<h2>Documentos adjuntos</h2>");
          docs = pry.adjuntos($("<div>").appendTo($dc), { ambito: "Item", token: d ? d.token : null, editable: !ro });
          // Hitos (opcionales): agrupan tareas en el cronograma
          const $h = $('<div class="card pad stack">').appendTo($x);
          $h.append("<h2>Hitos</h2>").append($('<p class="muted">').text("Opcionales. Agrupan las tareas en el cronograma; las fechas sirven de planificación mientras el hito no tenga tareas."));
          gHitos = $("<div>").appendTo($h).dxDataGrid({
            dataSource: hitos, keyExpr: "id", showBorders: true, showRowLines: true, paging: { enabled: false }, wordWrapEnabled: true, noDataText: "Sin hitos.",
            editing: ro ? {} : { mode: "cell", allowAdding: true, allowUpdating: true, allowDeleting: r => !r.row.data.tareas, confirmDelete: false, newRowPosition: "last", texts: { addRow: "Agregar hito" } },
            toolbar: ro ? { visible: false } : { items: [{ name: "addRowButton", showText: "always" }] },
            onInitNewRow: e => { e.data.id = "n" + Date.now(); e.data.hitoId = null; e.data.orden = hitos.length + 1; e.data.tareas = 0; },
            columns: [{ dataField: "orden", caption: "Orden", width: 80, dataType: "number" }, { dataField: "nombre", caption: "Hito", validationRules: [{ type: "required" }] },
              { dataField: "fechaInicio", caption: "Inicio", dataType: "date", format: "dd/MM/yyyy", width: 140 }, { dataField: "fechaFin", caption: "Fin", dataType: "date", format: "dd/MM/yyyy", width: 140 },
              { dataField: "tareas", caption: "Tareas", width: 80, allowEditing: false }].concat(ro ? [] : [{ type: "buttons", width: 50, buttons: ["delete"] }])
          }).dxDataGrid("instance");
          if (d) {
            const $t = $('<div class="card pad stack">').appendTo($x);
            $t.append("<h2>Tareas del ítem</h2>");
            pry.tareasDelItem($("<div>").appendTo($t), ts);
            const acc = [];
            if (pb.can("tareas", "crear") && ["Borrador", "Completado", "Anulado"].indexOf(d.estado) < 0) acc.push({ text: "Nueva tarea", icon: "add", type: "default", onClick: () => pry.tareaPopup(d.token, () => ficha(d.token, modo)) });
            if (pb.can("gantt", "ver")) acc.push({ text: "Ver en cronograma", icon: "event", onClick: () => { location.href = "/Portafolio/Cronograma?item=" + d.token; } });
            if (acc.length) pb.ui.mdActions($t, acc);
            const motivo = pry.motivoSinTareas(d.estado);
            if (motivo) pb.ui.mdNote($t, motivo);
          }
        },
        alGuardar: async f => {
          if (!docs.validar()) return;
          const g = await pb.post(pry.url("GuardarItem", d ? "token=" + d.token : ""), { tipo: f.tipo, titulo: f.titulo, descripcionHtml: editor.option("value") || null, responsableIds: f.responsables, estado: f.estado });
          if (g === undefined) return;
          await gHitos.saveEditData();
          const hs = gHitos.option("dataSource").filter(h => String(h.nombre || "").trim());
          if (hs.length || (d && d.hitos.length)) {
            const r = await pb.post(pry.url("Hitos", "token=" + g.token), { hitos: hs.map(h => ({ hitoId: h.hitoId, nombre: h.nombre, orden: h.orden || 1, inicio: pry.iso(h.fechaInicio), fin: pry.iso(h.fechaFin) })) });
            if (r === undefined) return ficha(g.token, "edicion");
          }
          if (!await docs.subir(g.token)) return ficha(g.token, "edicion");
          pb.notify("Registro " + g.codigo + " guardado correctamente");
          listado();
        },
        alEditar: () => ficha(token, "edicion"),
        alVolver: listado
      });
    }

    listado();
  });
</script>
}
