erDiagram
  Usuario ||--o{ Promocion : "crea y publica"
  Usuario ||--o{ Comunicado : "crea y publica"
  Promocion {
    int PromocionId PK
    uniqueidentifier Token
    varchar Codigo "PRM-001 (calculado)"
    nvarchar Titulo
    nvarchar Ubicacion "Panel principal, Inicio de sesión"
    varchar ImagenRuta "Blob Storage · contenedor marketing"
    varchar ImagenTipo "image/jpeg, image/png"
    nvarchar TextoAlternativo
    nvarchar Enlace "https"
    date Desde
    date Hasta
    nvarchar Audiencia "Todos o un rol (seg.Rol)"
    int Orden "orden en el carrusel"
    varchar Estado "Borrador, Publicado, Retirado · se muestra Programado o Vencido según la vigencia"
    int CreadoPorId FK "seg.Usuario"
    int PublicadoPorId FK "seg.Usuario"
    datetime2 FechaPublicacion
  }
  Comunicado {
    int ComunicadoId PK
    uniqueidentifier Token
    varchar Codigo "COM-001 (calculado)"
    nvarchar Titulo
    nvarchar Tipo "Aviso, Noticia, Mantenimiento, Campaña"
    nvarchar Resumen "tarjeta del Panel"
    nvarchar ContenidoHtml "secciones · editor enriquecido"
    nvarchar Contacto
    date Desde
    date Hasta
    nvarchar Audiencia "Todos o un rol (seg.Rol)"
    bit Destacado
    varchar Estado "Borrador, Publicado, Retirado"
    int CreadoPorId FK "seg.Usuario"
    int PublicadoPorId FK "seg.Usuario"
    datetime2 FechaPublicacion
  }
