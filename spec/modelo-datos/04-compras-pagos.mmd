erDiagram
  Presupuesto ||--|{ Partida : "se divide en"
  Partida ||--o{ Movimiento : origen
  Partida ||--o{ Movimiento : destino
  Proveedor ||--o{ Servicio : presta
  Partida ||--o{ Servicio : "se paga con"
  Servicio ||--o{ SolicitudCompra : "requerimiento de renovación"
  Proveedor ||--o{ SolicitudCompra : "a"
  Partida ||--o{ SolicitudCompra : imputa
  SolicitudCompra ||--o{ Pago : "se paga en"
  Pago ||--|{ Factura : adjunta
  Pago ||--|{ DistribucionPago : distribuye
  Partida ||--o{ DistribucionPago : "reduce saldo"
  Presupuesto {
    int PresupuestoId PK
    smallint Anio
    decimal MontoAsignado
    varchar Estado "borrador, activo, cerrado"
  }
  Partida {
    int PartidaId PK
    int PresupuestoId FK
    varchar Codigo
    nvarchar Nombre
    decimal MontoAsignado
    decimal MontoAjustado "calculado"
    decimal MontoConsumido "calculado"
    varchar Estado "borrador, activo, cerrado"
  }
  Movimiento {
    int MovimientoId PK
    int PartidaOrigenId FK
    int PartidaDestinoId FK
    varchar Tipo "ajuste, traslado, liberación"
    decimal Monto
    nvarchar Motivo
    date Fecha
  }
  Proveedor {
    int ProveedorId PK
    varchar Ruc
    nvarchar Nombre
  }
  Servicio {
    int ServicioId PK
    uniqueidentifier Token
    int ProveedorId FK
    int PartidaId FK "null si no presupuestado"
    bit Presupuestado
    nvarchar Nombre
    decimal CostoAnual
    date FechaVencimiento
    int DiasAviso "parametrizable por servicio"
    varchar Estado
  }
  SolicitudCompra {
    int SolicitudId PK
    uniqueidentifier Token
    int ServicioId FK "null si no es renovación"
    int ProveedorId FK
    int PartidaId FK "null si no presupuestado"
    bit Presupuestado
    int SolicitanteId FK "seg.Usuario"
    decimal Monto
    date Fecha
    nvarchar ContratoBlob "contrato adjunto"
    varchar Estado
  }
  Pago {
    int PagoId PK
    uniqueidentifier Token
    int SolicitudId FK
    date Fecha
    decimal Monto
    varchar Estado "registrado, anulado"
  }
  Factura {
    int FacturaId PK
    int PagoId FK
    nvarchar Numero
    date Fecha
    decimal Monto
    nvarchar ArchivoBlob "factura digital"
  }
  DistribucionPago {
    int DistribucionId PK
    int PagoId FK
    int PartidaId FK
    decimal Monto
    nvarchar ArchivoBlob "documento de distribución"
  }
