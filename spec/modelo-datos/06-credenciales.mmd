erDiagram
  GrupoAcceso ||--o{ GrupoAccesoMiembro : integra
  GrupoAcceso ||--o{ CuentaTecnica : "puede ver"
  GrupoAcceso ||--o{ Secreto : "puede ver"
  CuentaTecnica ||--o{ CredencialVersion : versiones
  Secreto ||--o{ CredencialVersion : versiones
  CuentaTecnica ||--o{ ConsultaCredencial : consultada
  Secreto ||--o{ ConsultaCredencial : consultado
  GrupoAcceso {
    int GrupoId PK
    nvarchar Nombre
    nvarchar Descripcion
  }
  GrupoAccesoMiembro {
    int GrupoId PK,FK
    int UsuarioId PK,FK "seg.Usuario"
  }
  Certificado {
    int CertificadoId PK
    uniqueidentifier Token
    nvarchar Nombre
    nvarchar Emisor
    nvarchar Sistema
    date FechaEmision
    date FechaVencimiento
    int DiasAviso
    int ResponsableId FK "seg.Usuario"
    varchar Estado "vigente, por vencer, vencido"
  }
  CuentaTecnica {
    int CuentaId PK
    uniqueidentifier Token
    nvarchar Nombre
    varchar Tipo "Entra ID, AD on-premise, base de datos"
    nvarchar Sistema
    nvarchar Uso
    int GrupoId FK
    varbinary Clave "Always Encrypted RANDOMIZED"
    int Version
    date FechaCambio
    date FechaRotacion
    varchar Estado
  }
  Secreto {
    int SecretoId PK
    uniqueidentifier Token
    nvarchar Nombre
    varchar Tipo "API key, cadena de conexión..."
    nvarchar Sistema
    nvarchar Ubicacion
    int GrupoId FK
    varbinary Valor "Always Encrypted RANDOMIZED"
    int Version
    date FechaExpiracion
    varchar Estado
  }
  CredencialVersion {
    bigint VersionId PK
    varchar TipoCredencial "cuenta o secreto"
    int CredencialId FK
    int Version
    datetime2 Fecha
    int UsuarioId FK "seg.Usuario"
  }
  ConsultaCredencial {
    bigint ConsultaId PK
    varchar TipoCredencial
    int CredencialId FK
    int UsuarioId FK "seg.Usuario"
    datetime2 Fecha
    varchar Ip
  }
