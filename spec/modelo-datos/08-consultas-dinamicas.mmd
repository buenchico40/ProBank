erDiagram
  Conexion ||--o{ ConsultaConexion : "permitida en"
  Consulta ||--o{ ConsultaConexion : usa
  Consulta ||--o{ Parametro : define
  Consulta ||--o{ ConsultaRol : "ejecutan"
  Consulta ||--o{ ConsultaAprobador : "aprueban (opcional)"
  Consulta ||--o{ Ejecucion : genera
  Ejecucion ||--o{ EjecucionAprobacion : decisiones
  Ejecucion ||--o{ EjecucionEvento : bitacora
  Consulta ||--o{ Programacion : programa
  Programacion ||--o{ ProgramacionDestinatario : envia
  Conexion {
    int ConexionId PK
    varchar Codigo
    nvarchar Nombre
    varchar Servidor
    varchar BaseDatos
    varchar Autenticacion
    varchar SecretoKeyVault "nombre del secreto, nunca la cadena"
    varchar Estado
  }
  Consulta {
    int ConsultaId PK
    varchar Codigo
    nvarchar Nombre
    sysname Procedimiento "solo SP"
    int TiempoMaximoSeg
    int LimiteFilas
    varchar Estado "Borrador, Publicada"
  }
  Parametro {
    int ParametroId PK
    int ConsultaId FK
    sysname Nombre
    nvarchar Etiqueta
    varchar Tipo
    bit Obligatorio
    nvarchar ValorDefecto "fijo o variable: Hoy, FinDeMes..."
  }
  Ejecucion {
    bigint EjecucionId PK
    varchar Codigo
    int ConsultaId FK
    int ConexionId FK
    int SolicitanteId FK
    nvarchar ParametrosResueltos
    int Filas
    int DuracionMs
    varchar Estado
  }
  EjecucionEvento {
    bigint EventoId PK
    bigint EjecucionId FK
    datetime2 Fecha
    int UsuarioId FK
    varchar Evento "Solicitud, Aprobacion, Rechazo, Ejecucion, Exportacion, EnvioCorreo"
    nvarchar Detalle
    varchar Resultado
    varchar Ip
  }
  Programacion {
    int ProgramacionId PK
    int ConsultaId FK
    int ConexionId FK
    varchar Frecuencia "Diaria, Semanal, Mensual"
    time Hora
    varchar Formato
    datetime2 ProximaEjecucion
    varchar Estado "Activa, Pausada, PendienteAprobacion"
  }
  ProgramacionDestinatario {
    int ProgramacionId PK,FK
    varchar EntraObjectId PK "usuario o grupo"
  }
