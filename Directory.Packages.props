<Project>
  <!-- Versiones centralizadas. Si una versión no restaura en tu feed, actualízala aquí una sola vez. -->
  <PropertyGroup>
    <!-- Permite fijar aquí versiones de dependencias transitivas (parches de seguridad). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Desde SqlClient 7 la autenticación Entra ID (Authentication=Active Directory ...) vive en este paquete. -->
    <PackageVersion Include="Microsoft.Data.SqlClient.Extensions.Azure" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient.AlwaysEncrypted.AzureKeyVaultProvider" Version="7.1.1" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.12.0" />
    <PackageVersion Include="Azure.Storage.Blobs" Version="12.30.1" />
    <PackageVersion Include="Microsoft.Graph" Version="6.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <!-- Pruebas -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- Transitivas fijadas por vulnerabilidades conocidas -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
  </ItemGroup>
</Project>
